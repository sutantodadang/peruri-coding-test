{
  "openapi": "3.0.3",
  "info": {
    "title": "Peruri Bulk Document API",
    "version": "1.0.0",
    "description": "Demo bulk document processing with real PostgreSQL. Authorize ApiToken for batch/document operations and CallbackToken for callbacks; enter the token without the Bearer prefix. Create a unique batch_no, process the batch, inspect its documents, then send a callback using the actual document ID and attempt_count. ProcessBatch waits for submission, not asynchronous completion. RetryFailed only requeues documents; call ProcessBatch again. SUCCESS is terminal, callbacks are idempotent, and each document has at most three attempts. Partial submission failures return 502/504 without rolling back successful submissions. Request bodies are limited to 1 MiB. Documentation is public; API operations require authentication."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API server"
    }
  ],
  "tags": [
    {
      "name": "Batches",
      "description": "Create, submit, inspect and retry batches."
    },
    {
      "name": "Documents",
      "description": "Submit one document and inspect callback audit events."
    },
    {
      "name": "Callbacks",
      "description": "Principal completion events; requires the separate callback token."
    },
    {
      "name": "System",
      "description": "Database health."
    }
  ],
  "security": [
    {
      "ApiToken": []
    }
  ],
  "paths": {
    "/batches": {
      "post": {
        "tags": [
          "Batches"
        ],
        "operationId": "CreateBatch",
        "summary": "Create a PENDING batch",
        "description": "Use a new batch_no for each demo. document_no must be unique within the batch. IDs, status, attempt_count and request_id are generated by the server; do not send these fields.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBatchRequest"
              },
              "examples": {
                "manual": {
                  "summary": "Manual callback demo",
                  "value": {
                    "batch_no": "demo-openapi-001",
                    "documents": [
                      {
                        "document_no": "DOC-001",
                        "payload": {
                          "mode": "manual"
                        }
                      }
                    ]
                  }
                },
                "mixed": {
                  "summary": "Partial submission failure (ProcessBatch returns 502)",
                  "value": {
                    "batch_no": "demo-openapi-mixed-001",
                    "documents": [
                      {
                        "document_no": "DOC-001",
                        "payload": {
                          "mode": "manual"
                        }
                      },
                      {
                        "document_no": "DOC-002",
                        "payload": {
                          "mode": "reject"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Batch and all documents committed atomically.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Batch"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/OperationError"
          }
        }
      }
    },
    "/batches/{no}/process": {
      "parameters": [
        {
          "$ref": "#/components/parameters/BatchNo"
        }
      ],
      "post": {
        "tags": [
          "Batches"
        ],
        "operationId": "ProcessBatch",
        "summary": "Submit all PENDING documents",
        "description": "At most three Principal requests are active across all batches in this service. Accepted documents stay PROCESSING until a callback arrives. A 502/504 can represent partial success: inspect documents before retrying. Non-PENDING documents are skipped, including terminal SUCCESS documents.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/SubmissionFinished"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "408": {
            "$ref": "#/components/responses/Canceled"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "502": {
            "$ref": "#/components/responses/SubmitFailed"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          },
          "default": {
            "$ref": "#/components/responses/OperationError"
          }
        }
      }
    },
    "/batches/{no}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/BatchNo"
        }
      ],
      "get": {
        "tags": [
          "Batches"
        ],
        "operationId": "GetBatchStatus",
        "summary": "Read batch progress and counts",
        "description": "COMPLETED means no PENDING/PROCESSING documents or retryable failures remain. It can include FAILED documents whose three attempts are exhausted.",
        "responses": {
          "200": {
            "description": "Current progress derived from persisted documents.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchStatus"
                },
                "example": {
                  "batch_no": "demo-openapi-001",
                  "status": "IN_PROGRESS",
                  "total": 2,
                  "counts": {
                    "PENDING": 0,
                    "PROCESSING": 1,
                    "SUCCESS": 0,
                    "FAILED": 1
                  },
                  "done": false
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/OperationError"
          }
        }
      }
    },
    "/batches/{no}/documents": {
      "parameters": [
        {
          "$ref": "#/components/parameters/BatchNo"
        }
      ],
      "get": {
        "tags": [
          "Batches"
        ],
        "operationId": "ListDocuments",
        "summary": "Inspect document IDs, statuses and attempts",
        "description": "Documents are ordered by ID. Copy document_id and attempt_count from here when sending a manual callback.",
        "responses": {
          "200": {
            "description": "Persisted documents in stable order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Document"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/OperationError"
          }
        }
      }
    },
    "/batches/{no}/retry": {
      "parameters": [
        {
          "$ref": "#/components/parameters/BatchNo"
        }
      ],
      "post": {
        "tags": [
          "Batches"
        ],
        "operationId": "RetryFailed",
        "summary": "Requeue eligible FAILED documents",
        "description": "Changes FAILED to PENDING only when attempt_count < 3 and next_retry_at <= current UTC time. Equal-jitter exponential backoff: first retry waits 1-2 seconds, second waits 2-4 seconds. Returns retried=0 before the deadline or when exhausted. Does not sleep, submit documents, or increment attempts. Inspect ListDocuments for next_retry_at, wait until due, then call RetryFailed and ProcessBatch.",
        "responses": {
          "200": {
            "description": "Number of documents requeued.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "retried"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "retried": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  }
                },
                "example": {
                  "retried": 1
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/OperationError"
          }
        }
      }
    },
    "/documents/{id}/process": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DocumentID"
        }
      ],
      "post": {
        "tags": [
          "Documents"
        ],
        "operationId": "ProcessDocument",
        "summary": "Submit one PENDING document",
        "description": "Claim is atomic. Concurrent submissions for the same document cannot submit the same attempt twice. Documents not eligible for a claim are skipped with 200. A successful response does not imply a SUCCESS callback has arrived.",
        "responses": {
          "200": {
            "description": "Document submitted or skipped.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "document processed or skipped"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "408": {
            "$ref": "#/components/responses/Canceled"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "502": {
            "$ref": "#/components/responses/SubmitFailed"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          },
          "default": {
            "$ref": "#/components/responses/OperationError"
          }
        }
      }
    },
    "/documents/{id}/callbacks": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DocumentID"
        }
      ],
      "get": {
        "tags": [
          "Documents"
        ],
        "operationId": "ListCallbacks",
        "summary": "Read unique callback audit events",
        "description": "Events are ordered by insertion ID. Replaying an identical callback_id does not add an event. A late FAILED event can appear in the audit without changing terminal SUCCESS.",
        "responses": {
          "200": {
            "description": "Callback audit events; empty array when none exist.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CallbackRequest"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/OperationError"
          }
        }
      }
    },
    "/callbacks": {
      "post": {
        "tags": [
          "Callbacks"
        ],
        "operationId": "HandleCallback",
        "summary": "Apply a Principal completion event",
        "security": [
          {
            "CallbackToken": []
          }
        ],
        "description": "Use CallbackToken, not ApiToken. Identical callback_id and content are idempotent. Reusing an ID with changed content or another document returns 409. SUCCESS is terminal; late FAILED cannot overwrite it. Future attempts return 409. SUCCESS while PENDING returns 409 without recording the event, so it can be replayed after claim. A known earlier SUCCESS can resolve a retried PROCESSING/FAILED document; an older FAILED cannot fail a new attempt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallbackRequest"
              },
              "example": {
                "callback_id": "event-openapi-001",
                "document_id": "1",
                "attempt_count": 1,
                "status": "SUCCESS",
                "message": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event applied, recorded without a state change, or acknowledged as an identical replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "callback acknowledged"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "default": {
            "$ref": "#/components/responses/OperationError"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "Health",
        "summary": "Check PostgreSQL connectivity",
        "security": [],
        "responses": {
          "200": {
            "description": "Database is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "503": {
            "description": "Database is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "database unavailable"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "API_TOKEN for batch and document operations. Enter the token only, without Bearer."
      },
      "CallbackToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "CALLBACK_TOKEN for POST /callbacks only. This differs from API_TOKEN. Enter the token only, without Bearer."
      }
    },
    "parameters": {
      "BatchNo": {
        "name": "no",
        "in": "path",
        "required": true,
        "description": "batch_no returned by CreateBatch (maximum 64 UTF-8 bytes).",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "example": "demo-openapi-001"
      },
      "DocumentID": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Actual document ID from create/list response; a canonical positive int64 encoded as a decimal string.",
        "schema": {
          "$ref": "#/components/schemas/DocumentID"
        },
        "example": "1"
      }
    },
    "schemas": {
      "DocumentID": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$",
        "maxLength": 19,
        "description": "Canonical positive decimal int64, at most 9223372036854775807. No plus sign or leading zeros.",
        "example": "1"
      },
      "Payload": {
        "description": "Any valid non-null JSON value. The local simulator reads mode from an object: manual, success, failed, reject, fail_once or timeout. Omitted mode defaults to success. These modes belong to the simulator only.",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": true
          },
          {
            "type": "array",
            "items": {}
          },
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ],
        "example": {
          "mode": "manual"
        }
      },
      "CreateDocumentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_no",
          "payload"
        ],
        "properties": {
          "document_no": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S",
            "description": "Nonblank, maximum 64 UTF-8 bytes; unique within the batch.",
            "example": "DOC-001"
          },
          "payload": {
            "$ref": "#/components/schemas/Payload"
          }
        }
      },
      "CreateBatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_no",
          "documents"
        ],
        "properties": {
          "batch_no": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S",
            "description": "Nonblank, maximum 64 UTF-8 bytes; globally unique.",
            "example": "demo-openapi-001"
          },
          "documents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "description": "document_no must be unique even when payloads differ.",
            "items": {
              "$ref": "#/components/schemas/CreateDocumentRequest"
            }
          }
        }
      },
      "Document": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "batch_id",
          "document_no",
          "payload",
          "status",
          "attempt_count",
          "request_id"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DocumentID"
          },
          "batch_id": {
            "$ref": "#/components/schemas/DocumentID"
          },
          "document_no": {
            "type": "string",
            "example": "DOC-001"
          },
          "payload": {
            "$ref": "#/components/schemas/Payload"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PROCESSING",
              "SUCCESS",
              "FAILED"
            ]
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "last_error": {
            "type": "string",
            "description": "Omitted when empty."
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable across retries; sent to Principal as Idempotency-Key."
          },
          "next_retry_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC retry deadline, present only for FAILED documents with attempts remaining. Equal jitter: attempt 1 waits 1-2 seconds, attempt 2 waits 2-4 seconds. Persisted across restarts."
          }
        }
      },
      "Batch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "batch_no",
          "documents"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DocumentID"
          },
          "batch_no": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          }
        }
      },
      "BatchStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_no",
          "status",
          "total",
          "counts",
          "done"
        ],
        "properties": {
          "batch_no": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "total": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "done": {
            "type": "boolean"
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "PENDING",
              "PROCESSING",
              "SUCCESS",
              "FAILED"
            ],
            "properties": {
              "PENDING": {
                "type": "integer",
                "minimum": 0
              },
              "PROCESSING": {
                "type": "integer",
                "minimum": 0
              },
              "SUCCESS": {
                "type": "integer",
                "minimum": 0
              },
              "FAILED": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "CallbackRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "callback_id",
          "document_id",
          "attempt_count",
          "status"
        ],
        "properties": {
          "callback_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S",
            "description": "Nonblank, maximum 128 UTF-8 bytes; unique event identity. Replays must preserve all content.",
            "example": "event-openapi-001"
          },
          "document_id": {
            "$ref": "#/components/schemas/DocumentID"
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "FAILED"
            ]
          },
          "message": {
            "type": "string",
            "nullable": true,
            "maxLength": 2048,
            "description": "Optional; maximum 2048 UTF-8 bytes. Null is treated as an empty string.",
            "example": ""
          }
        }
      },
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "CallbackConflict": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "code",
          "message",
          "document_status",
          "current_attempt_count",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "conflict"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "callback_future_attempt",
              "callback_requires_processing",
              "callback_id_reused"
            ]
          },
          "message": {
            "type": "string",
            "description": "Safe explanation and next action; does not echo callback message or stored event values."
          },
          "document_status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PROCESSING",
              "SUCCESS",
              "FAILED"
            ]
          },
          "current_attempt_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "description": "HTTP correlation ID matching X-Request-ID and server logs; differs from the document's stable request_id."
          },
          "conflicting_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "document_id",
                "attempt_count",
                "status",
                "message"
              ]
            },
            "description": "Names of fields that differ from the recorded callback; no previous or submitted values."
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "fields"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "validation failed"
            ]
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "rule"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "example": "documents[0].document_no"
                },
                "rule": {
                  "type": "string",
                  "example": "required"
                },
                "limit": {
                  "type": "string",
                  "description": "Validation parameter when applicable, such as 64, 3 or SUCCESS FAILED."
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "SubmissionFinished": {
        "description": "All eligible submissions finished. Accepted documents await callbacks.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Message"
            },
            "example": {
              "message": "submission finished; accepted documents await callbacks"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid JSON, unknown fields, invalid identifier or failed field validation. Validation errors include field paths and rules without echoing submitted values. Length rules use UTF-8 bytes.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "$ref": "#/components/schemas/ValidationError"
                }
              ]
            },
            "examples": {
              "validation": {
                "value": {
                  "error": "validation failed",
                  "fields": [
                    {
                      "field": "batch_no",
                      "rule": "required"
                    }
                  ]
                }
              },
              "json": {
                "value": {
                  "error": "invalid JSON request"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or wrong bearer token, including using the API token for callbacks or vice versa.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "unauthorized"
            }
          }
        }
      },
      "NotFound": {
        "description": "Batch or document does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "resource not found"
            }
          }
        }
      },
      "Conflict": {
        "description": "Duplicate batch number or callback conflict. Callback conflicts expose a safe code and current state: callback_requires_processing means submit the PENDING document first; callback_future_attempt means inspect the actual attempt count; callback_id_reused means replay unchanged content or use a new ID. conflicting_fields lists differences without values.",
        "headers": {
          "X-Request-ID": {
            "description": "Server-generated HTTP correlation ID matching the callback conflict response and structured logs.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "$ref": "#/components/schemas/CallbackConflict"
                }
              ]
            },
            "examples": {
              "pending": {
                "value": {
                  "error": "conflict",
                  "code": "callback_requires_processing",
                  "message": "document is PENDING; process the document before sending a SUCCESS callback",
                  "document_status": "PENDING",
                  "current_attempt_count": 1,
                  "request_id": "example-http-request-id"
                }
              },
              "batch": {
                "value": {
                  "error": "conflict"
                }
              }
            }
          }
        }
      },
      "TooLarge": {
        "description": "Request body exceeds 1 MiB.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "invalid JSON request"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "JSON body endpoints require Content-Type: application/json.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Content-Type must be application/json"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "The shared limit of 32 active API requests has been reached. Retry later.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "too many active requests"
            }
          }
        }
      },
      "Canceled": {
        "description": "Request context canceled; already claimed attempts are cleaned up or can be recovered by lease.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "operation canceled"
            }
          }
        }
      },
      "SubmitFailed": {
        "description": "One or more Principal submissions failed. Other submissions may have succeeded. Inspect persisted documents.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "principal submission failed; inspect documents for details"
            }
          }
        }
      },
      "Timeout": {
        "description": "Submission or request timed out. Inspect persisted document status before retrying.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "operation timed out; inspect document status before retry"
            }
          }
        }
      },
      "OperationError": {
        "description": "Other operation failure, such as an internal database error (500), cancellation (408) or timeout (504). Private error details are not returned.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
