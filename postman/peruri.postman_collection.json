{
  "info": {
    "name": "Peruri Bulk Document API - PostgreSQL Demo",
    "description": "Run all requests in order. Expected 502 on intentional rejections is a passing test. Local demonstration credentials only. Retry requests 09 and 11 read next_retry_at and wait until due before requeueing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "apiToken",
      "value": "local-api-token"
    },
    {
      "key": "callbackToken",
      "value": "local-callback-token"
    },
    {
      "key": "batchNo",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 CreateBatch",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"batch_no\": \"{{batchNo}}\",\n  \"documents\": [\n    {\n      \"document_no\": \"manual\",\n      \"payload\": {\n        \"mode\": \"manual\"\n      }\n    },\n    {\n      \"document_no\": \"reject\",\n      \"payload\": {\n        \"mode\": \"reject\"\n      }\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.variables.replaceIn(\"{{$guid}}\");",
              "pm.collectionVariables.set(\"batchNo\", \"postman-\" + id);",
              "pm.collectionVariables.set(\"eventId\", \"event-\" + id);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"documentId\", pm.response.json().documents[0].id);",
              "pm.test(\"All pending\", () => pm.expect(pm.response.json().documents.every(d => d.status === \"PENDING\")).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 ProcessBatch (expected 502: one rejection)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}/process"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 502\", () => pm.response.to.have.status(502));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 GetBatchStatus",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Callback SUCCESS",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{callbackToken}}"
          }
        ],
        "url": "{{baseUrl}}/callbacks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"callback_id\": \"{{eventId}}\",\n  \"document_id\": \"{{documentId}}\",\n  \"attempt_count\": 1,\n  \"status\": \"SUCCESS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Duplicate callback (same event ID)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{callbackToken}}"
          }
        ],
        "url": "{{baseUrl}}/callbacks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"callback_id\": \"{{eventId}}\",\n  \"document_id\": \"{{documentId}}\",\n  \"attempt_count\": 1,\n  \"status\": \"SUCCESS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Late FAILED (new event ID)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{callbackToken}}"
          }
        ],
        "url": "{{baseUrl}}/callbacks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"callback_id\": \"late-{{eventId}}\",\n  \"document_id\": \"{{documentId}}\",\n  \"attempt_count\": 1,\n  \"status\": \"FAILED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Verify SUCCESS retained",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"SUCCESS is terminal\", () => pm.expect(pm.response.json().counts.SUCCESS).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Audit callbacks (two unique events)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/documents/{{documentId}}/callbacks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Only two unique records\", () => pm.expect(pm.response.json().length).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 RetryFailed -> attempt 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}/retry"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"One requeued\", () => pm.expect(pm.response.json().retried).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Process attempt 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}/process"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 502\", () => pm.response.to.have.status(502));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 RetryFailed -> attempt 3",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}/retry"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Process attempt 3",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}/process"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 502\", () => pm.response.to.have.status(502));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Retry exhausted -> zero",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}/retry"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"No fourth attempt\", () => pm.expect(pm.response.json().retried).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Process terminal batch -> no-op",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}/process"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Final batch status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s = pm.response.json();",
              "pm.test(\"COMPLETED with one exhausted failure\", () => { pm.expect(s.status).to.eql(\"COMPLETED\"); pm.expect(s.counts.SUCCESS).to.eql(1); pm.expect(s.counts.FAILED).to.eql(1); pm.expect(s.done).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Documents and attempts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
        "url": "{{baseUrl}}/batches/{{batchNo}}/documents"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Attempts are 1 and 3\", () => pm.expect(pm.response.json().map(d => d.attempt_count)).to.eql([1, 3]));"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if ([\"09 RetryFailed -> attempt 2\", \"11 RetryFailed -> attempt 3\"].includes(pm.info.requestName)) {",
          "  pm.sendRequest({url: pm.variables.replaceIn(\"{{baseUrl}}/batches/{{batchNo}}/documents\"), method: \"GET\",",
          "    header: {Authorization: \"Bearer \" + pm.variables.get(\"apiToken\")}}, (err, response) => {",
          "      if (err) { throw err; }",
          "      pm.expect(response.code).to.eql(200);",
          "      const deadlines = response.json().filter(d => d.next_retry_at).map(d => Date.parse(d.next_retry_at));",
          "      pm.expect(deadlines.length, \"scheduled retry exists\").to.be.above(0);",
          "      const delay = Math.max(0, Math.max(...deadlines) - Date.now());",
          "      pm.expect(delay, \"bounded backoff\").to.be.at.most(4100);",
          "      setTimeout(() => {}, delay + 50);",
          "  });",
          "}"
        ]
      }
    }
  ]
}
